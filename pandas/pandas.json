import pandas as pd


def main():
    # A Series is like a labeled list of values.
    marks = pd.Series([85, 92, 78], name="Marks")
    print("Marks Series:")
    print(marks)

 # A DataFrame stores data in named columns, like a simple table.
    students = pd.DataFrame(
        {
            "Name": ["Asha", "Ravi", "Meera"],
            "Subject": ["Math", "Math", "Science"],
            "Marks": [85, 92, 78],
        }
    )

    print("\nStudent table:")
    print(students)



# Select a column and filter rows with a condition.
    print("\nNames:")
    print(students["Name"])

    high_scores = students[students["Marks"] >= 80]
    print("\nStudents with marks of 80 or more:")
    print(high_scores)


 # Add a new column, then calculate a summary.
    students["Passed"] = students["Marks"] >= 40
    print("\nAverage marks:", students["Marks"].mean())
    print("\nTable with Passed column:")
    print(students)
# basic no.2
import pandas as pd

data = {
    "Name": ["Asha", "Ravi", "Meera"],
    "Marks": [80, 90, 75]
}

students = pd.DataFrame(data)

print(students)

print("Names:")
print(students["Name"])

print("Students with marks above 80:")
print(students[students["Marks"] > 80])

print("Average marks:", students["Marks"].mean())


import numpy as np


def main():
    print("=== NUMPY PRACTICE ===")

    # Create an array
    numbers = np.array([10, 20, 30, 40, 50])
    print("Numbers:", numbers)
    print("First number:", numbers[0])
    print("First three numbers:", numbers[:3])

    # Do calculations on every item
    print("Add 5:", numbers + 5)
    print("Multiply by 2:", numbers * 2)

    # Select values using a condition
    print("Numbers greater than 25:", numbers[numbers > 25])

    # Create and reshape an array
    grid = np.arange(1, 7).reshape(2, 3)
    print("\n2D array:\n", grid)
    print("Shape:", grid.shape)

    # Calculate totals and averages
    scores = np.array([[80, 90, 85], [70, 88, 92]])
    print("\nScores:\n", scores)
    print("Column totals:", np.sum(scores, axis=0))
    print("Row averages:", np.mean(scores, axis=1))


