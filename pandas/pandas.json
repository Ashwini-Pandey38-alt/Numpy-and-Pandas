import pandas as pd

data = {
    "Name": ["Asha", "Ravi", "Meera"],
    "Marks": [80, 90, 75]
}

students = pd.DataFrame(data)

print(students)

print("Names:")
print(students["Name"])

print("Students with marks above 80:")
print(students[students["Marks"] > 80])

print("Average marks:", students["Marks"].mean())


import pandas as pd

data = {
    "Item": ["Lunch", "Bus", "Notebook", "Coffee", "Dinner"],
    "Category": ["Food", "Travel", "Study", "Food", "Food"],
    "Amount": [120, 40, 80, 60, 180]
}

expenses = pd.DataFrame(data)

print("My expenses:")
print(expenses)

# Total and average expense
print("\nTotal spent:", expenses["Amount"].sum())
print("Average expense:", expenses["Amount"].mean())

# Show only food expenses
food_expenses = expenses[expenses["Category"] == "Food"]
print("\nFood expenses:")
print(food_expenses)

# Add up expenses in each category
print("\nTotal spent by category:")
print(expenses.groupby("Category")["Amount"].sum())

# Find the most expensive item
biggest_expense = expenses.loc[expenses["Amount"].idxmax()]
print("\nMost expensive item:")
print(biggest_expense)

import pandas as pd

books = pd.DataFrame({
    "Book": ["Python Basics", "Math Guide", "English Stories", "Science Book"],
    "Price": [300, 250, 180, 400],
    "Quantity": [4, 10, 3, 6]
})

# Calculate the total value of each book's stock
books["Stock Value"] = books["Price"] * books["Quantity"]

print("Book shop inventory:")
print(books)

print("\nTotal value of all stock:")
print(books["Stock Value"].sum())

# Find books with fewer than 5 copies
low_stock = books[books["Quantity"] < 5]
print("\nBooks with low stock:")
print(low_stock)

print("\nBooks sorted by quantity:")
print(books.sort_values("Quantity"))


mport pandas as pd

movies = pd.DataFrame({
    "Movie": ["Movie A", "Movie B", "Movie C", "Movie D"],
    "Genre": ["Action", "Comedy", "Action", "Comedy"],
    "Rating": [8.2, 7.5, 9.0, 6.8]
})

print("All movies:")
print(movies)

# Show movies with a rating of 8 or more
good_movies = movies[movies["Rating"] >= 8]
print("\nMovies rated 8 or more:")
print(good_movies)

# Find the average rating
print("\nAverage rating:", movies["Rating"].mean())

