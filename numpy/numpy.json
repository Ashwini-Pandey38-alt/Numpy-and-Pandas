import numpy as np


def main():
    # Create a NumPy array from a regular Python list.
    numbers = np.array([10, 20, 30, 40, 50])
    print("1D array:", numbers)
    print("First item:", numbers[0])
    print("First three items:", numbers[:3])


 # NumPy can also represent data in rows and columns.
    scores = np.array([[80, 90, 85], [70, 88, 92]])
    print("\n2D array:\n", scores)
    print("Shape (rows, columns):", scores.shape)
    print("Value in row 1, column 2:", scores[0, 1])


# Arithmetic is applied to every item in the array.
    print("\nNumbers plus 5:", numbers + 5)
    print("Numbers multiplied by 2:", numbers * 2)



import numpy as np


def main():
    print("=== NUMPY PRACTICE ===")

    # Create an array
    numbers = np.array([10, 20, 30, 40, 50])
    print("Numbers:", numbers)
    print("First number:", numbers[0])
    print("First three numbers:", numbers[:3])

    # Do calculations on every item
    print("Add 5:", numbers + 5)
    print("Multiply by 2:", numbers * 2)

    # Select values using a condition
    print("Numbers greater than 25:", numbers[numbers > 25])

    # Create and reshape an array
    grid = np.arange(1, 7).reshape(2, 3)
    print("\n2D array:\n", grid)
    print("Shape:", grid.shape)

    # Calculate totals and averages
    scores = np.array([[80, 90, 85], [70, 88, 92]])
    print("\nScores:\n", scores)
    print("Column totals:", np.sum(scores, axis=0))
    print("Row averages:", np.mean(scores, axis=1))


if __name__ == "__main__":
    main()




import numpy as np

books = np.array(["Python Basics", "Math Guide", "English Stories", "Science Book"])
prices = np.array([300, 250, 180, 400])
quantity = np.array([4, 10, 3, 6])

# Calculate value of stock for each book
stock_value = prices * quantity

print("Book shop inventory:")

for i in range(len(books)):
    print(
        books[i],
        "- Price:", prices[i],
        "- Quantity:", quantity[i],
        "- Stock value:", stock_value[i]
    )

print("\nTotal value of all stock:", np.sum(stock_value))

# Find books with fewer than 5 copies
low_stock = quantity < 5
print("\nBooks with low stock:")
print(books[low_stock])